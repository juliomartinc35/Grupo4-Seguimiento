<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App_v3.Views.FichaPage"
             Title="Ficha del estudiante">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="SegPaginaClaro">#F4F5F7</Color>
            <Color x:Key="SegPaginaOscuro">#121212</Color>
            <Color x:Key="SegTarjetaClaro">#FFFFFF</Color>
            <Color x:Key="SegTarjetaOscuro">#1E1E1E</Color>
            <Color x:Key="SegBordeClaro">#E3E6EA</Color>
            <Color x:Key="SegBordeOscuro">#2E2E2E</Color>
            <Color x:Key="SegTextoClaro">#1F2937</Color>
            <Color x:Key="SegTextoOscuro">#F3F4F6</Color>
            <Color x:Key="SegSuaveClaro">#6B7280</Color>
            <Color x:Key="SegSuaveOscuro">#9CA3AF</Color>
            <Color x:Key="SegAvisoFondoClaro">#FEF3C7</Color>
            <Color x:Key="SegAvisoFondoOscuro">#3B2F0B</Color>
            <Color x:Key="SegAvisoTextoClaro">#92400E</Color>
            <Color x:Key="SegAvisoTextoOscuro">#FCD34D</Color>
            <Color x:Key="SegBotonSecundarioClaro">#E5E7EB</Color>
            <Color x:Key="SegBotonSecundarioOscuro">#2E2E2E</Color>

            <Style x:Key="Tarjeta" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SegTarjetaClaro}, Dark={StaticResource SegTarjetaOscuro}}" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource SegBordeClaro}, Dark={StaticResource SegBordeOscuro}}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="12" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Aviso" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SegAvisoFondoClaro}, Dark={StaticResource SegAvisoFondoOscuro}}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="10" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Titulo" TargetType="Label">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SegTextoClaro}, Dark={StaticResource SegTextoOscuro}}" />
            </Style>

            <Style x:Key="Seccion" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SegTextoClaro}, Dark={StaticResource SegTextoOscuro}}" />
            </Style>

            <Style x:Key="Texto" TargetType="Label">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SegTextoClaro}, Dark={StaticResource SegTextoOscuro}}" />
            </Style>

            <Style x:Key="Suave" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SegSuaveClaro}, Dark={StaticResource SegSuaveOscuro}}" />
            </Style>

            <Style x:Key="TextoAviso" TargetType="Label">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SegAvisoTextoClaro}, Dark={StaticResource SegAvisoTextoOscuro}}" />
            </Style>

            <Style x:Key="Campo" TargetType="Entry">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SegTextoClaro}, Dark={StaticResource SegTextoOscuro}}" />
                <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource SegSuaveClaro}, Dark={StaticResource SegSuaveOscuro}}" />
            </Style>

            <Style x:Key="Selector" TargetType="Picker">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SegTextoClaro}, Dark={StaticResource SegTextoOscuro}}" />
                <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource SegSuaveClaro}, Dark={StaticResource SegSuaveOscuro}}" />
            </Style>

            <Style x:Key="Fecha" TargetType="DatePicker">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SegTextoClaro}, Dark={StaticResource SegTextoOscuro}}" />
            </Style>

            <Style x:Key="BotonPrimario" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#512BD4" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HeightRequest" Value="44" />
            </Style>

            <Style x:Key="BotonSecundario" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SegBotonSecundarioClaro}, Dark={StaticResource SegBotonSecundarioOscuro}}" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SegTextoClaro}, Dark={StaticResource SegTextoOscuro}}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HeightRequest" Value="40" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource SegPaginaClaro}, Dark={StaticResource SegPaginaOscuro}}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">
                <Border Style="{StaticResource Tarjeta}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding NombreCompleto}" Style="{StaticResource Titulo}" />
                            <Label Text="{Binding Legajo, StringFormat='Legajo {0}'}" Style="{StaticResource Suave}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" BackgroundColor="{Binding ColorEstado}" StrokeThickness="0" Padding="12,6" VerticalOptions="Start">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label Text="{Binding EstadoTexto}" TextColor="White" FontAttributes="Bold" FontSize="12" />
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Datos personales" Style="{StaticResource Seccion}" />
                        <Label Text="{Binding Dni, StringFormat='DNI: {0}'}" Style="{StaticResource Texto}" />
                        <Label Text="{Binding Email, StringFormat='Email: {0}'}" Style="{StaticResource Texto}" />
                        <Label Text="{Binding Telefono, StringFormat='Teléfono: {0}'}" Style="{StaticResource Texto}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Text="Nivel de riesgo" Style="{StaticResource Seccion}" VerticalOptions="Center" />
                            <Border Grid.Column="1" BackgroundColor="{Binding ColorNivel}" StrokeThickness="0" Padding="12,6">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <Label Text="{Binding NivelTexto}" TextColor="White" FontAttributes="Bold" FontSize="12" />
                            </Border>
                        </Grid>
                        <Label Text="{Binding Motivo}" Style="{StaticResource Texto}" />
                        <Label Text="{Binding ResumenCursada}" Style="{StaticResource Suave}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Historial de asistencias" Style="{StaticResource Seccion}" />
                        <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Asistencias}">
                            <BindableLayout.EmptyView>
                                <Label Text="Todavía no hay asistencias registradas." Style="{StaticResource Suave}" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Titulo}" FontAttributes="Bold" Style="{StaticResource Texto}" />
                                            <Label Text="{Binding Detalle}" Style="{StaticResource Suave}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding Estado}" TextColor="{Binding ColorEstado}" FontAttributes="Bold" VerticalOptions="Start" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Entregas de trabajos prácticos" Style="{StaticResource Seccion}" />
                        <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Entregas}">
                            <BindableLayout.EmptyView>
                                <Label Text="Todavía no hay trabajos cargados." Style="{StaticResource Suave}" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Titulo}" FontAttributes="Bold" Style="{StaticResource Texto}" />
                                            <Label Text="{Binding Detalle}" Style="{StaticResource Suave}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding Estado}" TextColor="{Binding ColorEstado}" FontAttributes="Bold" VerticalOptions="Start" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Contactos realizados" Style="{StaticResource Seccion}" />
                        <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Contactos}">
                            <BindableLayout.EmptyView>
                                <Label Text="Todavía no se registraron contactos." Style="{StaticResource Suave}" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Titulo}" FontAttributes="Bold" Style="{StaticResource Texto}" />
                                            <Label Text="{Binding Detalle}" Style="{StaticResource Suave}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding Estado}" TextColor="{Binding ColorEstado}" FontAttributes="Bold" VerticalOptions="Start" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Tarjeta}" IsVisible="{Binding EsActivo}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Registrar contacto" Style="{StaticResource Seccion}" />
                        <DatePicker Date="{Binding FechaContacto, Mode=TwoWay}" Style="{StaticResource Fecha}" />
                        <Picker Title="Medio *" ItemsSource="{Binding Medios}" SelectedItem="{Binding Medio, Mode=TwoWay}" Style="{StaticResource Selector}" />
                        <Picker Title="Resultado *" ItemsSource="{Binding Resultados}" SelectedItem="{Binding Resultado, Mode=TwoWay}" Style="{StaticResource Selector}" />
                        <Editor Placeholder="Notas del contacto *" Text="{Binding Notas}" HeightRequest="90" AutoSize="TextChanges" />
                        <Button Text="Registrar Contacto" Command="{Binding RegistrarContactoCommand}" Style="{StaticResource BotonPrimario}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
